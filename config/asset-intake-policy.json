{
  "schemaVersion": "vexworld.asset-intake-policy/v1",
  "policyRef": "policy.vexworld.external-asset-intake.v1",
  "purpose": "Permit bounded use of open assets as replaceable structural references or expression inputs without letting downloaded art become canonical identity, silently inheriting incompatible rights, or copying proprietary expression.",
  "defaultDisposition": "QUARANTINE_PENDING_EXACT_PROVENANCE_AND_LICENSE",
  "requiredIntakeFields": [
    "assetCandidateRef",
    "displayName",
    "assetClass",
    "officialSourceUrl",
    "sourcePublisherRef",
    "artifactVersionOrRelease",
    "downloadedAtOrNull",
    "sha256OrNull",
    "licenseSpdxOrExactIdentifier",
    "licenseSourceUrl",
    "permittedUseSummary",
    "attributionRequirement",
    "modificationRecordRefs",
    "intendedVexWorldUse",
    "localPathOrNull",
    "disposition"
  ],
  "licenseClasses": {
    "FRIENDLY_REFERENCE_AND_DERIVATION": ["CC0-1.0"],
    "REQUIRES_ATTRIBUTION_OR_COMPONENT_REVIEW": [
      "CC-BY-4.0",
      "MIT",
      "Apache-2.0",
      "BSD-2-Clause",
      "BSD-3-Clause",
      "OFL-1.1"
    ],
    "BLOCKED_UNTIL_SEPARATE_DECISION": [
      "UNKNOWN",
      "CUSTOM_UNREVIEWED",
      "NO-DERIVATIVES",
      "NONCOMMERCIAL",
      "EDITORIAL-ONLY",
      "PROPRIETARY"
    ]
  },
  "intakeLifecycle": [
    "RESEARCHED_NOT_DOWNLOADED",
    "QUARANTINED_EXACT_ARTIFACT",
    "LICENSE_AND_RIGHTS_REVIEWED",
    "STRUCTURE_ANALYZED",
    "SEMANTIC_ADAPTER_MAPPED",
    "REPLACEMENT_TEST_PASSED",
    "ACCEPTED_REFERENCE_STRUCTURE_ONLY",
    "ACCEPTED_EXPRESSION_INPUT",
    "REJECTED",
    "SUPERSEDED"
  ],
  "permanentRules": [
    "ASSET_FILE != CHARACTER_IDENTITY",
    "SKELETON_BONE_NAME != SEMANTIC_JOINT_IDENTITY",
    "ANIMATION_CLIP_NAME != ACTION_IDENTITY",
    "DOWNLOADED != LICENSE_ACCEPTED",
    "OPEN_SOURCE_CODE != AUTOMATIC_ASSET_RIGHTS",
    "STRUCTURAL_ANALYSIS != RIGHT_TO_COPY_DISTINCTIVE_EXPRESSION",
    "REFERENCE_ASSET != PERMANENT_DEPENDENCY",
    "ATTRIBUTION_REQUIREMENT != OPTIONAL",
    "UNKNOWN_LICENSE != SAFE_DEFAULT"
  ],
  "requiredReplacementProof": {
    "description": "At least one accepted VexWorld-owned or independently licensed substitute must be able to replace the reference asset through the same semantic body, socket, material and animation-intent adapter without changing canonical character identity or gameplay capability.",
    "requiredFor": ["ACCEPTED_REFERENCE_STRUCTURE_ONLY", "ACCEPTED_EXPRESSION_INPUT"]
  },
