{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VexWorld party",
  "type": "object",
  "required": [
    "schemaVersion",
    "partyRef",
    "capacity",
    "members"
  ],
  "properties": {
    "schemaVersion": {
      "const": "vexworld.party/v1"
    },
    "partyRef": {
      "type": "string"
    },
    "capacity": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4
    },
    "members": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4
    }
  },
  "additionalProperties": true
}
